<cangaroo-workspace>
 <tabs>
  <tab TimestampMode="2" title="Trace" mode="linear" type="TraceWindow">
   <LinearTraceView AutoScroll="1"/>
   <AggregatedTraceView SortColumn="-1"/>
  </tab>
 </tabs>
 <setup>
  <network name="Network 1">
   <interfaces>
    <interface bitrate="500000" bitrate-fd="4000000" auto-restart="0" configure="1" sample-point-fd="875" auto-restart-time="100" type="can" driver="CANable SLCAN" can-fd="0" listen-only="0" one-shot="0" name="COM8" sample-point="875" triple-sampling="0"/>
   </interfaces>
   <databases/>
  </network>
 </setup>
</cangaroo-workspace>
