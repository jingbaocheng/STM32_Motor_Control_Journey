--cpu=Cortex-M4.fp
"pwm_light\startup_stm32f407xx.o"
"pwm_light\main.o"
"pwm_light\gpio.o"
"pwm_light\tim.o"
"pwm_light\stm32f4xx_it.o"
"pwm_light\stm32f4xx_hal_msp.o"
"pwm_light\stm32f4xx_hal_tim.o"
"pwm_light\stm32f4xx_hal_tim_ex.o"
"pwm_light\stm32f4xx_hal_rcc.o"
"pwm_light\stm32f4xx_hal_rcc_ex.o"
"pwm_light\stm32f4xx_hal_flash.o"
"pwm_light\stm32f4xx_hal_flash_ex.o"
"pwm_light\stm32f4xx_hal_flash_ramfunc.o"
"pwm_light\stm32f4xx_hal_gpio.o"
"pwm_light\stm32f4xx_hal_dma_ex.o"
"pwm_light\stm32f4xx_hal_dma.o"
"pwm_light\stm32f4xx_hal_pwr.o"
"pwm_light\stm32f4xx_hal_pwr_ex.o"
"pwm_light\stm32f4xx_hal_cortex.o"
"pwm_light\stm32f4xx_hal.o"
"pwm_light\stm32f4xx_hal_exti.o"
"pwm_light\system_stm32f4xx.o"
--strict --scatter "PWM_Light\PWM_Light.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "PWM_Light.map" -o PWM_Light\PWM_Light.axf