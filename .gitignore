# ==========================================
# 医疗级双轴控制系统 - 工业级 .gitignore
# 涵盖 STM32 固件、Python 上位机与操作系统环境
# ==========================================

# ------------------------------------------
# 1. Python & 上位机环境 (保持干净的沙盒)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
build/
dist/
*.spec

# ------------------------------------------
# 2. STM32 & Keil MDK 编译废料 (极其庞大，必须屏蔽)
# ------------------------------------------
# 保留核心源码、CubeMX 的 .ioc 和 Keil 的 .uvprojx 工程文件
# 屏蔽以下所有编译生成的中间产物和二进制文件
*.o
*.d
*.crf
*.htm
*.dep
*.map
*.lst
*.lnp
*.axf
*.sct
*.hex
*.bin
*.iex
*.bak
# 屏蔽个人本地的窗口布局文件
*.uvguix.*
*.uvoptx
DebugConfig/
RTE/
Objects/
Listings/

# ------------------------------------------
# 3. 常见 IDE 与操作系统缓存 (防止协同冲突)
# ------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
