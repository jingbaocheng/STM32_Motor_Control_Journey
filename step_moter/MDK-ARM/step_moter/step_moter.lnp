--cpu=Cortex-M4.fp
"step_moter\startup_stm32f407xx.o"
"step_moter\main.o"
"step_moter\gpio.o"
"step_moter\tim.o"
"step_moter\usart.o"
"step_moter\stm32f4xx_it.o"
"step_moter\stm32f4xx_hal_msp.o"
"step_moter\stm32f4xx_hal_tim.o"
"step_moter\stm32f4xx_hal_tim_ex.o"
"step_moter\stm32f4xx_hal_rcc.o"
"step_moter\stm32f4xx_hal_rcc_ex.o"
"step_moter\stm32f4xx_hal_flash.o"
"step_moter\stm32f4xx_hal_flash_ex.o"
"step_moter\stm32f4xx_hal_flash_ramfunc.o"
"step_moter\stm32f4xx_hal_gpio.o"
"step_moter\stm32f4xx_hal_dma_ex.o"
"step_moter\stm32f4xx_hal_dma.o"
"step_moter\stm32f4xx_hal_pwr.o"
"step_moter\stm32f4xx_hal_pwr_ex.o"
